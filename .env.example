# Kopie als ".env" speichern und anpassen. Wird beim Start gelesen (Neustart nötig).
# Echte Umgebungsvariablen haben Vorrang vor dieser Datei.

# Dev-Modus (simulierter Minecraft-Server, Daten in .dev/) – gleich wie "npm run dev"
# MCPANEL_DEV=1

# Panel
# MCPANEL_HOST=0.0.0.0
# MCPANEL_PORT=8080
# Startpasswort für den Benutzer "admin" (gilt nur beim allerersten Start; im Dev-Modus sonst "dev")
# MCPANEL_PASSWORD=
# Ordner für config.json, Protokoll, Server-Ordner und Backups (Standard: der Programmordner; Docker: /data)
# MCPANEL_DATA=/var/lib/mcpanel

# Hinter einem Reverse-Proxy (nginx, Caddy, Traefik): woher die echte Besucher-Adresse kommt (für die Anmelde-Sperre).
#   loopback = Standard: Proxy läuft auf demselben Rechner · 1, 2, … = Anzahl der Proxys davor · IP/Netz, z. B. 172.18.0.0/16 · false = nie vertrauen
# MCPANEL_TRUST_PROXY=loopback
# Cookie mit „Secure“-Flag: wird bei HTTPS automatisch gesetzt (auch hinter dem Proxy, wenn er X-Forwarded-Proto sendet). 1 = immer, 0 = nie
# MCPANEL_COOKIE_SECURE=

# Discord-Benachrichtigungen (Webhook-Adresse aus Discord: Kanal bearbeiten → Integrationen → Webhooks)
# DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_ENABLED=true

# Discord-Login (überschreibt die Einstellungen im Panel, bleibt auch bestehen, wenn .dev/ gelöscht wird)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
# DISCORD_ENABLED=true
