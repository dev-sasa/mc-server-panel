{
  "name": "mc-server-panel",
  "version": "1.0.1",
  "description": "Self-hosted web panel for managing a Minecraft Java server on Linux",
  "private": true,
  "license": "MIT",
  "keywords": [
    "minecraft",
    "server",
    "panel",
    "dashboard",
    "paper",
    "fabric",
    "forge",
    "neoforge",
    "self-hosted"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "MCPANEL_DEV=1 node --watch-path=server.js --watch-path=lib --watch-path=routes --watch-path=dev server.js",
    "check": "node --check server.js && for f in lib/*.js routes/*.js test/*.js public/app.js public/login.js dev/fake-mc.js; do node --check $f || exit 1; done",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "qrcode-generator": "1.4.4",
    "ws": "^8.18.0"
  }
}
